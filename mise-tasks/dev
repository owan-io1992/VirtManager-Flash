#!/usr/bin/env bash
#MISE description="Install dependencies and start the Tauri development server"
set -euo pipefail

echo "Installing dependencies..."
bun install || {
  echo "Error: bun install failed!" >&2
  exit 1
}

echo "Starting Tauri dev server..."
bun tauri dev || {
  echo "Error: bun tauri dev failed!" >&2
  exit 1
}
